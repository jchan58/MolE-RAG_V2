runs/                   # per-molecule prediction outputs
scores/SCORES_fw_multi.json   # live scorer output (regenerated by score_fw_multi.py)
predictions/            # saved predictions fetched via scripts/fetch_predictions.sh
*.jsonl.gz
*.parquet

