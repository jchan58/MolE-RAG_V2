# ============================================================================
# MolE-RAG reproduction — credentials template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in ONLY the keys for what you intend to run.
# `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Two reproduction depths (see README):
#   DEPTH A — reproduce Table 1 & Table 2 on the pre-built cards (default).
#             You need ONLY the LLM backbone(s) for the model rows you want.
#   DEPTH B — rebuild the chemistry card corpus from PMC full text (optional,
#             heavy). Adds NCBI + Cohere on top of a Bedrock extraction key.
#
# No key is required unless you run the part that uses it. To reproduce just
# the Qwen3-32B column of Table 1, a single Bedrock credential is enough.
# ============================================================================

# ----------------------------------------------------------------------------
# DEPTH A — LLM backbones (fill in the ones whose rows you want to reproduce)
# ----------------------------------------------------------------------------

# The framework calls models through an OpenAI-compatible API. You choose the
# endpoints in `models.json` (each model's base_url + model id). Put the API
# key(s) here; the names must match the `api_key_env` fields in models.json.
# To reproduce the paper, serve the model ids shipped in models.json.

# Key for the endpoint(s) serving Qwen3-32B, Ministral-3-14B, Opus 4.6 and the
# retrieval embedder. models.json points all four at MOLERAG_API_KEY by default
# (one OpenAI-compatible gateway); use several keys if you split providers.
MOLERAG_API_KEY=

# Key for GPT-5-mini (models.json points it at OpenAI by default).
OPENAI_API_KEY=

AWS_REGION=us-east-1

# Standard AWS keys — only for the ChemDFM baseline (SageMaker endpoint) and for
# fetching data/cards from S3. NOT needed to run the four main models.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# DEPTH B — corpus rebuild only (PMC full text -> entity-attribute cards).
# Skip entirely if you use the pre-built cards. See corpus/README.md.
# ----------------------------------------------------------------------------

# NCBI E-utilities — PMC search/fetch (a free key raises the rate limit).
NCBI_API_KEY=
NCBI_EMAIL=                       # a contact email, required by NCBI's policy

# Bedrock bearer token — query generation (Claude Opus), the LLM extraction
# fleet, and Cohere embed/rerank all go through Bedrock in this pipeline.
# (Same AWS_BEARER_TOKEN_BEDROCK; set it here if you only run Depth B.)
AWS_BEARER_TOKEN_BEDROCK=

# OPENAI_API_KEY (declared above) is reused only if you run the OpenAI judge stage.
# PMC full text is read anonymously from the public pmc-oa-opendata S3 bucket.

# ----------------------------------------------------------------------------
# Data source (defaults are fine for most users)
# ----------------------------------------------------------------------------

# Hugging Face dataset holding the pre-built cards (public: no token needed to
# download). Set a token only if you fork the dataset to a private repo.
MOLERAG_CARDS_HF_REPO=            # e.g. <your-hf-username>/molerag-cards
HF_TOKEN=

# Optional path overrides (defaults are repo-relative; leave blank to use them):
#   MOLERAG_DATA  -> MoleculeNet scaffold splits   (default: data/moleculenet/seed_0)
#   MOLERAG_CARDS -> chemistry card corpus          (default: data/cards)
#   MOLERAG_RUNS  -> where per-molecule outputs go  (default: runs/)
MOLERAG_DATA=
MOLERAG_CARDS=
MOLERAG_RUNS=
