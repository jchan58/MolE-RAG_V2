 "notes": {
  "formula_heavy_atoms_assignment": "formula + heavy_atoms assigned to the DESCRIPTORS component (RDKit-computed size features of the same family; removed in MR_no_desc; absent in S/R). heavy_atoms duplicates HeavyAtomCount already in the 15-descriptor list.",
  "MRD_no_id": "= the REPORTED fw_multi arm-A initial context (fact_block + refs_block + diff_block, NO identifiers). Reusable from existing runs. NOT one of the 8 primary conditions.",
  "M_Rbare": "OPTIONAL factorial point: query molecular context + BARE refs (no ref annotations, no comparisons).",
  "ablation_base": "MR_no_id / MR_no_desc / MR_no_fg are ablations of MR (NOT MRD): no comparison block, so a removed component cannot be silently reintroduced by a comparison. Removed from BOTH query and refs.",
  "reference_invariance": "The 5 references (identity + order) are IDENTICAL across all ref-containing conditions; removing reference annotations does NOT change which refs were selected.",
  "independence": "Each condition is an INDEPENDENT prediction call (fresh), never seeded with another condition's rationale; literature (arm C) and self-review (arm B) are disabled."
 },
